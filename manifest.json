{
  "manifest_version": 3,
  "name": "THU Auto Login",
  "version": "1.0.3",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://learn.tsinghua.edu.cn/f/login",
        "https://id.tsinghua.edu.cn/*"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_page": "options.html"
}